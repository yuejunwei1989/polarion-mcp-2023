# Polarion server, e.g. https://polarion.example.com
# The server appends /polarion/rest/v1 automatically. You may also paste the full
# REST URL (https://host/polarion/rest/v1); it is normalised.
POLARION_URL=https://polarion.example.com

# --- Authentication ---------------------------------------------------------
# Polarion 2023 supports Basic auth everywhere. PAT works on 2310 when the
# administrator enabled com.siemens.polarion.rest.security.restApiToken.enabled.
POLARION_AUTH_MODE=auto          # auto | basic | token
POLARION_USERNAME=alice
POLARION_PASSWORD=change-me
# POLARION_TOKEN=pat-xxxxxxxxxxxx

# --- Behaviour --------------------------------------------------------------
POLARION_DEFAULT_PROJECT=MyProject
POLARION_READ_ONLY=0             # 1 exposes read tools only
POLARION_VERIFY_SSL=true         # false for self-signed certificates
POLARION_TIMEOUT=30
POLARION_PAGE_SIZE=100
POLARION_MAX_PAGE_SIZE=100       # Polarion 2023 default cap
POLARION_MAX_ITEMS=1000
POLARION_API_FLAVOR=auto         # auto | 2023 | 2025
POLARION_LOG_LEVEL=INFO

# --- MCP transport ----------------------------------------------------------
POLARION_MCP_TRANSPORT=stdio     # stdio | streamable-http | sse
POLARION_MCP_HOST=127.0.0.1
POLARION_MCP_PORT=8000
